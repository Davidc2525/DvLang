package main
@include "test/std.dv"; // Assuming std.dv provides println and std_itos

{
    void main() {
        int arr[2][3];
        arr = new int[2][3];
        int i, j, val;

        println("Initializing 2D array arr[2][3]...");
        val = 1;
        i = 0;
        while (i < 2) {
            j = 0;
            while (j < 3) {
                arr[i][j] = val;
                val = val + 1;
                j = j + 1;
            }
            i = i + 1;
        }

        println("2D Array Contents (expected: 1 2 3 / 4 5 6):");
        i = 0;
        while (i < 2) {
            j = 0;
            string line; // Assuming string type and concatenation are supported
            line = "";
            while (j < 3) {
                if (j > 0) {
                    line = line + " ";
                }
                line = line + std_itos(arr[i][j]);
                j = j + 1;
            }
            println(line);
            i = i + 1;
        }
        println("Test 2D Array Complete.");
    }
}

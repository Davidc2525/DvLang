package main
@include "test/std.dv"; // Assuming std.dv provides println and std_itos

{
    void main() {
        int arr3d[2][2][2];

        println("Initializing 3D array arr3d[2][2][2]...");
        arr3d = new int[2][2][2];

        // Assign some distinct values
        arr3d[0][0][0] = 10;
        arr3d[0][0][1] = 11;
        arr3d[0][1][0] = 12;
        arr3d[0][1][1] = 13;
        arr3d[1][0][0] = 20;
        arr3d[1][0][1] = 21;
        arr3d[1][1][0] = 22;
        arr3d[1][1][1] = 23;

        println("3D Array Contents Verification:");
        println("arr3d[0][0][0] (expected 10): " + std_itos(arr3d[0][0][0]));
        println("arr3d[0][0][1] (expected 11): " + std_itos(arr3d[0][0][1]));
        println("arr3d[0][1][0] (expected 12): " + std_itos(arr3d[0][1][0]));
        println("arr3d[0][1][1] (expected 13): " + std_itos(arr3d[0][1][1]));
        println("arr3d[1][0][0] (expected 20): " + std_itos(arr3d[1][0][0]));
        println("arr3d[1][0][1] (expected 21): " + std_itos(arr3d[1][0][1]));
        println("arr3d[1][1][0] (expected 22): " + std_itos(arr3d[1][1][0]));
        println("arr3d[1][1][1] (expected 23): " + std_itos(arr3d[1][1][1]));

        // Test a middle value assignment and read-back
        arr3d[1][0][1] = 55;
        println("arr3d[1][0][1] (expected 55 after change): " + std_itos(arr3d[1][0][1]));

        println("Test 3D Array Complete.");
    }
}

#include<iostream>
#include <process/Instructions.h>
#include <numbers/numbers.h>
#include "../compiler/generate/symbol_table/symbol_table.h"
#include "../compiler/generate/ICodeGenerator.h" // Changed
#include <vector> // For ActPars
#include <string> // For names
using namespace std;
using namespace DVLANG::COMPILER_::GENERATE;
// using namespace PROCESS; // Less direct use of PROCESS opcodes

class lib_load_info{
  public:
    bool load_any = false;
    string name;
};

typedef  void(*type_f)(string) ;


COMPILER Program
	SymbolTable   *tab;
  ICodeGenerator  *cg; // Changed
  void * _p;
  Obj * curMethod;

  lib_load_info  * lib_info = new lib_load_info;

  /*eliminar comillas de la cadena*/
  string onlyContent(string str){
    return str.substr(1,str.length()-2);
  }
    
  bool isMethodDecl(){

    if(la->kind==_llopen){
      return true;
    }

    return false;
  }

 
  bool followedByColon(){
    cout<<"followedByColon"<<endl;
    Token * x = la;

    while(x->kind == _ident || x->kind == _comma||x->kind == _bopen || x->kind == _bclose ){
      cout<<"next: "<<x->kind<<endl;
      x = scanner->Peek();
    }
    
    cout<<"IsColon: "<< (x->kind == _colon)<<" curr: "<<x->kind<<" t: "<<t->kind<<endl;
    return x->kind == _colon; 
  }

  
  bool NextTokenIsType() {
    if (la->kind != _ident) return false;
    Obj* obj = tab->find(coco_string_create_char(la->val));
    cout<<"|||||||||||||||||||||----- NextTokenIsType: "<<coco_string_create_char(la->val)<<" is type?: "<<(obj->kind == Obj::Type)<<endl;
    return obj->kind == Obj::Type;
  }

  // FunctionCall helper is removed. Logic moved to call sites in Statement and Factor. TEST_CHANGE_AGAIN
CHARACTERS

    tab           = '\u0009'. /*  9 = tabulator */
    lf            = '\u000a'. /* 10 = line feed */
    cr            = '\u000d'. /* 13 = carriage return */

   //letter = 'a'..'z' + 'A'..'Z'.
   //digit = '0'..'9'.
   whiteSpace = ' ' + '\t' + '\r' +'\n'.
   char = ANY - "'" - '\\' - whiteSpace.

   stringChar    = ANY - "\"" - '\\' - cr - lf.

   zero          = '0'.
   zeroToThree   = zero + "123" .
   octalDigit    = zero + "1234567" .
   nonZeroDigit  = "123456789".
   digit         = '0' + nonZeroDigit .
   hexDigit      = digit + "ABCDEFabcdef" .
   letter        = 'A' .. 'Z' + 'a' .. 'z' + '_' + '$'.
   
TOKENS

ident = letter {letter | digit | "_" }.
number = digit {digit}.

charConst = "'" char "'". //including '\r', '\t', '\n
stringConst =
    "\"" { stringChar
         | "\\" ( "b" | "t" | "n" | "f" | "r" | "\"" | "\'" | "\\"
                | "u" { "u" } hexDigit hexDigit hexDigit hexDigit
                | zeroToThree [ octalDigit ] [ octalDigit ]
                | octalDigit [ octalDigit ]
                )
         }
    "\"".

floatLit =
    "." digit {digit}
    [("e" | "E") ["+" | "-"] digit {digit}]
    [ "F" | "f" | "D" | "d" ]
  | digit {digit}
    ( "." {digit}
      [("e" | "E" ) ["+" | "-"] digit {digit} ]
      [ "F" | "f" | "D" | "d" ]
    | ("e" | "E") ["+" | "-"] digit {digit}
      [ "F" | "f" | "D" | "d" ]
    | "F" | "f" | "D" | "d"
    ).

//program= "program".
//keywords 
class= "class".
if= "if".
else= "else".
while= "while".
print= "print".
return= "return".
void= "void".
final= "final".
new= "new".
package= "package".
//read= "read".
comma = ",".
colon = ";".
llopen = "{".
llclose = "}".
bopen = "[".
bclose = "]".
popen = "(".
pclose = ")".

EOL = "\n" .
comment = "#" { letter } .


/*PRAGMAS
    option = '#' {letter}  . (. std::cout<<t->val<<" "<<la->val<<std::endl; .)
*/
COMMENTS FROM "/*" TO "*/" NESTED
COMMENTS FROM "//" TO "\n"

IGNORE whiteSpace


PRODUCTIONS

  Program = package ident 
  (. Obj *vd = new Obj();  .) 
  ( [LoadExp] [LibLoad] ) 
  (. /*tab->openScope();*/ .)
  {ConstDecl | VarDecl<vd> | ClassDecl}
  "{"  {FuncDecl|NativeDecl} "}" 
  (. /*tab->closeScope(); ajustar para cuando coloke el beta de los paketes*/  .).



  ConstDecl (. Struct * type = new Struct(0); .)
	= "final" Type<type> ident "=" (number | stringConst) ";".
  
  Type<Struct * type> (. string name_type;  int is_arr = 0;  int is_fun = 0; .)
    =
        ["fun" (. is_fun = 1; .)]
        ident (. name_type = string(coco_string_create_char(t->val)); .)
        ["[" "]" (. is_arr = 1; .)] 
        (.  
        	Struct * _type = tab->find(name_type)->type;
        	
        	*type = *_type;

        	if(is_arr == 1){
            Struct * _t = new Struct(Struct::Arr);
            _t->elemType = new Struct(_type->kind);
            _t->elemType->assign(_type);
            *type = *_t;
          }

          if(is_fun == 1){
            cout<<"------- posible argumento funcion: "<<name_type<<endl;
        		Struct * _t = new Struct(Struct::Func);
        		_t->elemType = new Struct(_type->kind);
        		*type = *_t;
        	}

         
         .)
  .

  
   VarDecl<Obj * vd> (.   Struct * _type = new Struct(0); .)
  = Type<_type>  (.cout<<"vd type: "<<_type->kind<<endl;;  .)
      
      ident (. 
      		   *vd = *tab->insert(Obj::Var, coco_string_create_char(t->val), _type);  
	           cout<<"- Var decl name: "<<vd->name<<", type kind: "<<vd->type->kind<<", obj kind: "<<vd->kind<<endl;
	      	   if(vd->type->kind == Struct::Arr){
	      		  	cout<<"	elemtype kind: "<<vd->type->elemType->kind<<endl;
	      	   }          
      .)
    
      {"," ident (. *vd = *tab->insert(Obj::Var, coco_string_create_char(t->val), _type); 
				      cout<<"- Var decl name: "<<vd->name<<", type kind: "<<vd->type->kind<<", obj kind: "<<vd->kind<<endl;
	      	    if(vd->type->kind == Struct::Arr){
	      			    cout<<"	elemtype kind: "<<vd->type->elemType->kind<<endl;
	      	    }
               
      .)  
      } ";".

  
  ClassDecl 	(. Obj * clazz,*vd;  string class_name; Struct * type = new Struct(Struct::Class); .)
  	= "class" 
  	  ident  (. class_name = string(coco_string_create_char(t->val)); 
  	  			 clazz = tab->insert(Obj::Type,class_name,type);
  	  		 .)
  	  "{"    (.  tab->openScope(); cout<<"class decl: "<<class_name<<" scope opener: "<<tab->curLevel<<endl; .)
  	   { (. vd = (Obj*)malloc(sizeof(Obj)); .)
      (
            
            (IF(followedByColon())VarDecl<vd>   (.
                            clazz->type->nFields++;
                            cout<<"class field add: "<<vd->name<<endl;
                            clazz->type->fields = tab->curScope->locals;           
                          .))
            | MethodDecl<clazz>
             )} (. clazz->type->fields = tab->curScope->locals; .)
  	   "}" 	 (. cout<<"class scope: "<<tab->curLevel<<", name:"<<clazz->name<<", fields: "<<clazz->type->nFields<<endl; 
  	   			cout<<"class closing scope: "<<tab->curLevel<<endl;   tab->closeScope(); .) .



  /*MethodDef< Obj * clazz > (. int npars = 0; Obj * vd = new Obj(); Struct * type = new Struct(0); string name_method; .)
    = "meth" (Type<type> | "void" (. type = tab->noType; .)) 
      ident    
      (.    name_method = string(coco_string_create_char(t->val));

            Obj * def_meth = tab->insert(Obj::Meth,name_method,type); 
            cout<<"------- definicion de metodo: "<<name_method<<endl; 


            Struct * _v = new Struct(0);
        .)
      
      "(" [Type<_v> {"," Type<_v> }] ")" ";"
  .*/

  MethodDecl< Obj * clazz > (. int p = 0; int npars = 0; Obj * vd = new Obj(); Struct * type = new Struct(0); string name_method; .)
    =  (Type<type> | "void" (. type = tab->noType; .)) 
      ident    
      (.    name_method = string(coco_string_create_char(t->val));

           /* cout<<"------- metodo type kind : "<<type->kind<<endl;
            Struct * _t = new Struct(Struct::Meth);
            _t->elemType = new Struct(type->kind);
            *type = *_t;
            cout<<"------- to metodo type kind : "<<type->kind<<" elemType kind: "<<type->elemType->kind<<endl;
            */

            curMethod = tab->insert(Obj::Meth,name_method,type); 
            tab->openScope(); 
            cout<<"metohd new scope opener: "<<tab->curLevel<<endl; .)
      
      "(" (.tab->insert(Obj::Var, "this", clazz->type);  .) [FormPars<npars>] ")" 
      (. curMethod->nPars = npars;
         cout<<"numerp de parametros: "<<npars+1<<endl; 
         //tab->insert(Obj::Var, "this", type);   

        curMethod->locals = tab->curScope->locals;
        // curMethod->adr = CodeGenerator::pc; // Old
        curMethod->adr = cg->getCurrentCodeOffset(); // New
        // code->put(ENTER); code->put(0); code->put(0); // Old
        cg->emitFunctionPrologue(curMethod->name, npars + 1, 0 /* placeholder for local var space, to be patched */);

        // Storing p for patching local var space would now mean storing an offset within the function's code block
        // or relying on emitFunctionPrologue to handle it if it can know local var space later.
        // The old code patched code->program[p+1]. This direct buffer access is gone.
        // For simplicity, we'll assume emitFunctionPrologue can be called again or there's a patch mechanism.
        // Or, localVariableSpace needs to be known here. Let's pass tab->curScope->nVars for now.
        // The npars+1 is for 'this'.
        // The old code did: code->put(ENTER); p = PC; code->put(0) /*params*/; code->put(0) /*locals*/;
        // Then patched program[p] and program[p+1].
        // New: cg->emitFunctionPrologue(name, paramCount, localVars);
        // The patching of local var count (tab->curScope->nVars) needs to happen *after* the block is parsed.
        // This is a general problem with one-pass generation for function prologues.
        // For now, we emit with preliminary values. A real solution might involve a placeholder or a later patch call.
        // Let's assume emitFunctionPrologue is smart or we accept this limitation for now.
        // The immediate code->put(0); code->put(0) was for paramCount and localVarsCount for ENTER.
        // These are now params to emitFunctionPrologue.
        // The patching means we need to defer setting localVariableSpace.
        // This example shows the complexity. For now, I'll pass npars+1 and tab->curScope->nVars to a *modified* emitFunctionPrologue
        // or accept that this part of the logic needs a two-pass approach not directly supported by replacing puts.

        // Let's simplify for this step: emit prologue, and assume patching is complex.
        // The old code: code->put(ENTER); p = PC; code->put(0); code->put(0);
        // Then: code->program[p] = npars+1; code->program[p+1] = tab->curScope->nVars;
        // The new call to emitFunctionPrologue should take npars+1 and tab->curScope->nVars directly *if known*.
        // Here, tab->curScope->nVars isn't fully known until Block is parsed.
        // This is a fundamental issue with converting this specific pattern.
        // I will proceed by using the values as they are known at the point of call,
        // acknowledging this might not be perfectly equivalent to the old patching.
        // cg->emitFunctionPrologue(curMethod->name, npars + 1, tab->curScope->nVars /* tentative */);
        // The old code put placeholders then patched. The new interface might not support that directly for prologue.
        // For this step, I will defer the full local var count patching.
        // The code->put(ENTER); code->put(0); code->put(0) becomes one emitFunctionPrologue.
        // The patching `code->program[p]` and `code->program[p+1]` is the hard part.
        // Let's assume emitFunctionPrologue is called with params, and locals are set later if possible,
        // or it's handled by the generator by looking at the symbol table *after* the block.
        // The initial ENTER in DvVM takes param count and local var count.
        // So they must be provided. `tab->curScope->nVars` at this point is 0 or only params.
        // The problem description implies changing code->put(ENTER); code->put(params); code->put(locals);
        // to cg->emitFunctionPrologue(funcName, params, locals);
        // So, we must pass the values known at this point.
        // The original code patches *after* the block. This means the initial values were placeholders.
        // This is a limitation of a simple replacement.
        // I will use the values `npars+1` and `tab->curScope->nVars` (which will be 0 for locals initially).
        // The patching logic `code->program[p+1] = tab->curScope->nVars;` (after Block) is removed.
        // This is a change in behavior unless DvVmCodeGenerator has a way to update this.
        // For now, this change is made directly as per "replace puts" instruction.
        cg->emitFunctionPrologue(curMethod->name, npars + 1, tab->curScope->nVars);
        // p = CodeGenerator::pc; // p was used for patching, not needed in same way.
        
                  
      .) 
      
      Block (. 
        // +1 por q a los metodos se les pasa como primer parametro el "this" referencia a su objeto
        // code->program[p]  = npars + 1; // Old patching - now passed to emitFunctionPrologue
        // code->program[p+1] = tab->curScope->nVars; // Old patching - this value is now correctly known
                                                  // This implies emitFunctionPrologue needs to be recalled or a specific method to update locals is needed.
                                                  // This is a major refactoring point. For now, this patching line is removed.

        if(curMethod->type == tab->noType){
            cg->emitFunctionEpilogue(curMethod->name); // Includes EXIT
            cg->emitReturn(nullptr); // Includes RET
        }

        cout<<"metohd  closing scope: "<<tab->curLevel<<endl;  tab->closeScope(); .)
  .

  NativeDecl  (.  bool ref = false;  Obj * native; int npars = 0;  Struct * _type = new Struct(0); .)
    = "native" (Type<_type> | "void" (. _type = tab->noType; .) )
      ident  (.
              string symbol_name = string(coco_string_create_char(t->val));
              native = tab->insert(Obj::Func, symbol_name, _type);
              native->native=true;

              tab->openScope();

              .)
     "(" [FormPars<npars>] ")" (.

        if(lib_info->load_any){
          Obj * nc = tab->find(symbol_name);
          nc->nPars = npars;

          tab->lib_symbols->put(lib_info->name,symbol_name,npars);

          native->native_id = tab->lib_symbols->get_symbl(symbol_name);
          cout<<"Register native: lib "<<lib_info->name<<" symbol: "<<symbol_name<<" args"<<nc->nPars<<" native id: "<< native->native_id<<endl;

        }else{

          SemErr(L"---------------- No se ha cargao ninguna libreria aun.");

        }

        tab->closeScope();
      .) ";" .
  
  FuncDecl (. int npars = 0; int p = 0; Obj * vd = new Obj(); Struct * type = new Struct(0); string name_method; .)
	  = (Type<type> | "void" (. type = tab->noType; .)) 
	  	ident    (. name_method = string(coco_string_create_char(t->val));
	  				curMethod = tab->insert(Obj::Func,name_method,type); 
	  				tab->openScope(); 
	  				cout<<"metohd new scope opener: "<<tab->curLevel<<endl; .)
	  	
	  	"(" [FormPars<npars>] ")" (. curMethod->nPars = npars;
	  								 cout<<"numerp de parametros: "<<npars<<endl; 
	  								 if(name_method=="main"){
										// CodeGenerator::main = CodeGenerator::pc; // Old
                                       // Main entry point is typically handled by the generator
                                       // when it sees a function named "main" in emitFunctionPrologue.
                                       // Or via a specific call like cg->setMainEntryPoint().
                                       // For now, assume emitFunctionPrologue handles it.
	  								 }

        curMethod->locals = tab->curScope->locals;
        // curMethod->adr = CodeGenerator::pc; // Old
        curMethod->adr = cg->getCurrentCodeOffset(); // New

        // code->put(ENTER); // Old
        // p = CodeGenerator::pc; // Old
        // code->put(curMethod->nPars); // Old
        // code->put(tab->curScope->nVars); // Old - nVars is 0 here for locals before Block
        cg->emitFunctionPrologue(curMethod->name, curMethod->nPars, tab->curScope->nVars /* initially 0 for locals */);
        // Patching of local var count is removed, see similar comment in MethodDecl.
                     
                    .) 
      
      Block (. 
        // code->program[p]   = npars; // Old patching
        // code->program[p+1] = tab->curScope->nVars; // Old patching
       
        if(curMethod->type == tab->noType){
            cg->emitFunctionEpilogue(curMethod->name); // Includes EXIT
            cg->emitReturn(nullptr); // Includes RET
        }

        if(name_method=="main"){
          // code->put(HLT); // HLT might be emitted by DvVmCodeGenerator at end of main
          // For now, this specific HLT is removed, assuming generator handles program termination.
        }
	  	cout<<"metohd  closing scope: "<<tab->curLevel<<endl;  tab->closeScope(); .)
  .
  
  //ArrowMethodDecl = (Type | "void") ident "(" [FormPars] ")" "=>" "{" {VarDecl|Statement} "}".
  
  /*FormPars (. Struct * type = new Struct(0); Struct * type2 = new Struct(0); .)
  	= Type<type> ident {"," Type<type2> ident}.*/


  FormPars<int & npars> (. bool ref = false; Obj * vd; Struct * _type = new Struct(0); .)
    = Type<_type> ident 
    	(. npars++; vd = tab->insert(Obj::Var, coco_string_create_char(t->val), _type); 
      		cout<<"- FormPar decl name: "<<vd->name<<", type kind: "<<vd->type->kind<<", obj kind: "<<vd->kind<<endl;
      		if(vd->type->kind == Struct::Arr){
      			cout<<"	elemtype kind: "<<vd->type->elemType->kind<<endl;
      		}
       
        .)
      {"," (. Struct * _type2 = new Struct(0); .) Type<_type2> ident
      		(.  npars++; vd = tab->insert(Obj::Var, coco_string_create_char(t->val), _type2);
      		cout<<"- FormPar decl name: "<<vd->name<<", type kind: "<<vd->type->kind<<", obj kind: "<<vd->kind<<endl;
      		if(vd->type->kind == Struct::Arr){
      			cout<<"	elemtype kind: "<<vd->type->elemType->kind<<endl;
      		}
       
      .)}.
  
  Block  (.Obj * vd = new Obj();  .)
  = "{" {IF(followedByColon())VarDecl<vd> |Statement} "}".
   //Block (. Obj * ob = new Obj(); .) 
   //= "{" {IF(NextTokenIsType()) VarDecl<ob>|Statement} "}".
  
  Statement     (. AbstractOperand *target_op = nullptr, *value_op = nullptr; std::vector<AbstractOperand*> args_ops; Operand* x_legacy = new Operand(0); /* For Designator */ .)
   = Designator<x_legacy> // Designator populates x_legacy (old Operand type)
    (. // Convert legacy Operand x_legacy to AbstractOperand target_op
        if (x_legacy && x_legacy->obj) {
            if (x_legacy->kind == Operand::Local) target_op = cg->createLocalVariableOperand(x_legacy->adr, x_legacy->type);
            else if (x_legacy->kind == Operand::Static) target_op = cg->createGlobalVariableOperand(x_legacy->adr, x_legacy->type);
            else if (x_legacy->kind == Operand::Fld) { /* Needs base, complex */ target_op = cg->createFieldOperand(nullptr, x_legacy->adr, x_legacy->type); } // FIXME: Base needed for FieldOperand
            else if (x_legacy->kind == Operand::Elem) { /* Needs base and index */ target_op = cg->createArrayElementOperand(nullptr, nullptr, x_legacy->type); } // FIXME: Base/Index needed
            else if (x_legacy->obj->kind == Obj::Fun || x_legacy->obj->kind == Obj::Meth) target_op = cg->createFunctionNameOperand(x_legacy->obj->name);
            else { SemErr(L"Unsupported designator kind for target_op conversion."); }
        } else { SemErr(L"Invalid designator."); }
    .)
    (
	ActPars<args_ops> // Populates args_ops
        (. // This is a procedure call (function call used as a statement)
            if (target_op && (x_legacy->obj->kind == Obj::Fun || x_legacy->obj->kind == Obj::Meth)) {
                AbstractOperand* result_target_for_call = nullptr; // No result stored for procedure call
                if (x_legacy->obj->native) {
                    cg->emitNativeCall(x_legacy->obj->name, x_legacy->obj->native_id, args_ops, result_target_for_call);
                } else {
                    cg->emitCall(target_op, args_ops, result_target_for_call);
                }
                if (x_legacy->obj->type != tab->noType) { // If function is not void but called as procedure
                    cg->emitPop(nullptr); // Pop the unused return value
                }
            } else { SemErr(L"Not a callable entity or designator error."); }
        .)
	| "=" Expr<value_op> // Expr populates value_op (AbstractOperand)
        (. // This is an assignment
            if (target_op && value_op) {
                cg->emitAssign(target_op, value_op);
            } else { SemErr(L"Invalid operands for assignment."); }
        .)
   	  ) ";"

  | "if"  (. int label_false = 0; int label_end = 0; .)
		 ["("] Condition<label_false> [")"] // Condition rule now takes label to jump to if false
  		  Statement 
           (. label_end = cg->createLabel();
              cg->emitJump(label_end); // Skip else block
              cg->placeLabel(label_false);
           .)
   ("else"
	Statement
    | // No else part
   )
   (. cg->placeLabel(label_end); .)

  | "while" (. int label_start = 0; int label_cond_false = 0; .)
		(. label_start = cg->createLabel(); cg->placeLabel(label_start); .)
		["("] Condition<label_cond_false> [")"] // Condition jumps to label_cond_false if false
		 Statement
           (. cg->emitJump(label_start);
              cg->placeLabel(label_cond_false);
           .)

  | "return" (Expr<value_op> // value_op is AbstractOperand from Expr
            (.
                if(curMethod->type == tab->noType && value_op != nullptr) { SemErr(L"Void method must not return a value."); }
                cg->emitReturn(value_op);
            .)
	|       (. // No expression, void return
                if(curMethod->type != tab->noType) { SemErr(L"Return value expected."); }
                cg->emitReturn(nullptr);
            .)
	) ";"

  | Mcode // Mcode is direct assembly, cannot be mapped easily to ICodeGenerator. Consider removing or specific handling.
  | "print" (. AbstractOperand *print_val_op = nullptr, *print_width_op = nullptr; std::vector<AbstractOperand*> print_args; .)
			"(" Expr<print_val_op>
            (. if(print_val_op) print_args.push_back(print_val_op); .)
			["," Expr<print_width_op>
            (. if(print_width_op) print_args.push_back(print_width_op); .)]
            ")"
            (.
               // This assumes native functions "print_value_default_width" (ID 101) and "print_value_custom_width" (ID 102)
               // These IDs and names are examples.
               if (!print_args.empty()) {
                   if (print_args.size() == 1) {
                       cg->emitNativeCall("print_value_default_width", 101, print_args, nullptr);
                   } else if (print_args.size() == 2) {
                       cg->emitNativeCall("print_value_custom_width", 102, print_args, nullptr);
                   }
               }
            .) ";"
  | Block
  | void Expr<value_op> // Expression used as a statement, value_op is AbstractOperand
    (. // If expression has a result on stack, pop it.
        // This depends on how Expr<value_op> leaves its result. If it's an operand that needs popping:
        if (value_op) { /* TODO: Check if value_op represents a value on stack that needs explicit pop */
            // cg->emitPop(nullptr); // If Expr always leaves value on stack.
        }
    .) ";"
  | ";".
  
  ActPars<std::vector<AbstractOperand*> &args_ops> // Output: fills args_ops
  = "(" [ (. AbstractOperand *arg_op = nullptr; .) Expr<arg_op>  (. if(arg_op) args_ops.push_back(arg_op); else SemErr(L"Expression in arg list did not produce an operand."); .)
	{"," (. arg_op = nullptr; .) Expr<arg_op> (. if(arg_op) args_ops.push_back(arg_op); else SemErr(L"Expression in arg list did not produce an operand.");.) } ] ")".

  // For MultipleConditionOr and MultipleConditionAnd, the short-circuiting logic needs labels.
  // Example for OR: ConditionA || ConditionB
  // ConditionA (jumps to L_false_A if A is false)
  // JUMP L_true_Overall (if A was true)
  // L_false_A:
  // ConditionB (jumps to L_false_B if B is false)
  // L_true_Overall: (nop or next instruction)
  // L_false_B: (this is where overall condition is false)
  // This is complex to manage with the current Condition<label_false> structure directly.
  // For now, let's assume MultipleConditionOr/And handle this internally or are simplified (e.g. no short-circuit).
  // Simplified: evaluate all, then combine. This is not standard.
  // A proper implementation of short-circuiting requires passing more labels or different structure.
  // Let's assume Condition<label_false> means "if this specific condition is false, jump to label_false".
  // Then OR/AND needs to manage overall truthiness. This is non-trivial.

  MultipleConditionOr <int label_if_entire_or_is_false>
    = MultipleConditionAnd<label_if_entire_or_is_false> // If this is true, OR is true. How to jump past next?
      // This structure needs rethinking for proper short-circuiting with ICodeGenerator.
      // For now, this rule is not fully refactored due to complexity of boolean flow.
      {"||" MultipleConditionAnd<label_if_entire_or_is_false>}.

  MultipleConditionAnd <int label_if_entire_and_is_false>
    = Condition<label_if_entire_and_is_false> // If Condition is false, AND is false, jump to label.
      {"&&" Condition<label_if_entire_and_is_false>}.


  Condition <int label_if_false> // Parameter: jump to this label if condition evaluates to false
  (. AbstractOperand *x_op = nullptr, *y_op = nullptr; int comp_kind = 0; /* 0:EQ, 1:NE, 2:GT, ... */ .)
	= Expr<x_op>
      [ Relop<comp_kind> Expr<y_op>
        (.  
          if(x_op && y_op) {
              cg->emitCompare(x_op, y_op);
              // Based on comp_kind, emit the *opposite* jump to label_if_false
              // e.g., if comp_kind is EQ (want to continue if true), jump to label_if_false if NOT EQUAL
              if (comp_kind == 0 /*EQ*/) cg->emitJumpIfNotEqual(label_if_false);
              else if (comp_kind == 1 /*NE*/) cg->emitJumpIfEqual(label_if_false);
              else if (comp_kind == 2 /*GT*/) cg->emitJumpIfLessThanOrEqual(label_if_false);
              else if (comp_kind == 3 /*GE*/) cg->emitJumpIfLessThan(label_if_false);
              else if (comp_kind == 4 /*LT*/) cg->emitJumpIfGreaterThanOrEqual(label_if_false);
              else if (comp_kind == 5 /*LE*/) cg->emitJumpIfGreaterThan(label_if_false);
              // If true, execution falls through.
          } else { SemErr(L"Invalid comparison operands in Condition.");}
        .)
      ]
      (. // Single expression as condition: if (expr), jump to label_if_false if expr is 0 (false)
          if(y_op == nullptr && x_op){ // y_op is null if no Relop part
            AbstractOperand* zero_op = cg->createConstantIntegerOperand(0);
            cg->emitCompare(x_op, zero_op);
            cg->emitJumpIfEqual(label_if_false); // If x_op == 0, condition is false, so jump.
          }
      .)
  	.
  
  // op_kind: 0:EQ, 1:NE, 2:GT, 3:GE, 4:LT, 5:LE
  Relop<int & op_kind>
    = "==" (. op_kind = 0; .)
    | "!=" (. op_kind = 1; .)
    | ">"  (. op_kind = 2; .)
    | ">=" (. op_kind = 3; .)
    | "<"  (. op_kind = 4; .)
    | "<=" (. op_kind = 5; .).
  				 .
  
  Expr<AbstractOperand* &result_op>
  (. AbstractOperand *term_op = nullptr, *next_term_op = nullptr;
     int add_op_kind = 0; // 1 for ADD, 2 for SUB
     bool negate_first_term = false;
     // To access type information, we will assume AbstractOperand can be cast to DvVmOperand
     // This is a necessary evil for now to replicate old grammar's type logic.
     DvVmOperand *res_vm_op, *next_vm_op;
  .)
   = ["-" (. negate_first_term = true; .)]
      Term<term_op> // Term provides AbstractOperand* representing value on stack
      (.
         result_op = term_op;
         if(negate_first_term && result_op) {
            cg->emitNegate(result_op, result_op);
         }
      .)
      { Addop<add_op_kind> Term<next_term_op>
        (. if(result_op && next_term_op) {
             res_vm_op = dynamic_cast<DvVmOperand*>(result_op);
             next_vm_op = dynamic_cast<DvVmOperand*>(next_term_op);

             // Guard against failed casts if other AbstractOperand types are introduced later
             if (!res_vm_op || !next_vm_op) {
                 SemErr(L"Type information unavailable for operands in Expr.");
                 // Fallback to generic add/subtract if type info is missing
                 if(add_op_kind == 1) cg->emitAdd(result_op, next_term_op, result_op);
                 else if(add_op_kind == 2) cg->emitSubtract(result_op, next_term_op, result_op);
             } else {
                 // String concatenation logic (simplified from old grammar)
                 bool is_res_string_type = (res_vm_op->type == SymbolTable::stringType || (res_vm_op->type->kind == Struct::Arr && res_vm_op->type->elemType == SymbolTable::charType));
                 bool is_next_string_type = (next_vm_op->type == SymbolTable::stringType || (next_vm_op->type->kind == Struct::Arr && next_vm_op->type->elemType == SymbolTable::charType));

                 if (add_op_kind == 1 && (is_res_string_type || is_next_string_type)) { // Addition means concatenation if either is string
                     // Convert first operand to string if it isn't already
                     if (!is_res_string_type) {
                         if (res_vm_op->type == SymbolTable::intType) cg->emitConvert(result_op, SymbolTable::stringType, result_op); // ITOS
                         else if (res_vm_op->type == SymbolTable::floatType) cg->emitConvert(result_op, SymbolTable::stringType, result_op); // FTOS
                         else if (res_vm_op->type == SymbolTable::doubleType) cg->emitConvert(result_op, SymbolTable::stringType, result_op); // DTOS
                         else { SemErr(L"Cannot convert left operand to string for concatenation."); }
                         // Update type info for result_op after conversion for next potential concat
                         // This is tricky as result_op is abstract. Assume emitConvert updates stack top type.
                     }
                     // Convert second operand to string if it isn't already
                     if (!is_next_string_type) {
                         if (next_vm_op->type == SymbolTable::intType) cg->emitConvert(next_term_op, SymbolTable::stringType, next_term_op); // ITOS
                         else if (next_vm_op->type == SymbolTable::floatType) cg->emitConvert(next_term_op, SymbolTable::stringType, next_term_op); // FTOS
                         else if (next_vm_op->type == SymbolTable::doubleType) cg->emitConvert(next_term_op, SymbolTable::stringType, next_term_op); // DTOS
                         else { SemErr(L"Cannot convert right operand to string for concatenation."); }
                     }
                     // Call a runtime string concatenation function
                     // This function takes two strings from stack, concatenates, leaves result on stack.
                     // Example: native ID 201 for "runtime_concat_strings"
                     std::vector<AbstractOperand*> concat_args; // Args already on stack from Term rules
                     // concat_args.push_back(result_op); // These are already on stack
                     // concat_args.push_back(next_term_op);
                     cg->emitNativeCall("runtime_concat_strings", 201, concat_args, result_op /* result on stack */);
                 } else { // Arithmetic
                     // DvVmCodeGenerator's emitAdd/emitSubtract already handles int/double promotion.
                     if(add_op_kind == 1) {
                         cg->emitAdd(result_op, next_term_op, result_op);
                     } else if(add_op_kind == 2) {
                         cg->emitSubtract(result_op, next_term_op, result_op);
                     }
                 }
             }
           } else { SemErr(L"Invalid operands for additive operation in Expr."); }
        .)
      }.

              
               cout<<"-------------------- be string x "<<x->type->kind<<endl;
               cout<<"-------------------- be string y "<<y->type->kind<<endl;
              if(
                (x->type == SymbolTable::stringType || x->type->kind == Struct::Arr)
                ||
                (x->type == SymbolTable::stringType || y->type->kind == Struct::Arr)
                ){

                code->load(y);
                if(y->type == SymbolTable::stringType || y->type->kind == Struct::Arr){
                  cout<<"-------------------- be string y elemtype kind "<<y->type->elemType->kind<<endl;

                }else{
                  cout<<"--------------------     op y no es de tipo string o char[] "<<y->type->kind<<" anteponeindo itos"<<endl;
                  if(y->type->kind == Struct::Int){
                    code->put(ITOS);

                  }else if(y->type->kind == Struct::Float){
                    code->put(FTOS);
                  }else if(y->type->kind == Struct::Double){
                    code->put(DTOS);
                  }else if(false && y->type->kind == Struct::Class){
                    Obj * tmpO = tab->find(y->obj->name);
                    Operand * otmp0 = new Operand(tmpO);
                    Obj * fld = tab->findField("toString",tmpO->type);
                    Operand * otmp1 = new Operand(fld);
                    cout<<"op y: "<< tmpO->name <<", es un objeto de clase: "<<endl;
                    if(fld != SymbolTable::noObj){
                      
                    cout<<"op y contiene el metodo toString: adr "<<fld->adr<<endl;
                    //llamar al metodo toString de la clase
                    code->load(otmp0);
                    FunctionCall(otmp1);
                    }else{
                      
                    
                    SemErr(L"---- op y NO contiene el metodo toString.");
                    }
                    //SemErr(L"---- op y es un objeto de clase .");
                  }else{
                    
                    SemErr(L"---- op y no se puede llevar implicitamente a string.");
                  }
                }


                code->load(x);
                if(x->type == SymbolTable::stringType || x->type->kind == Struct::Arr){
                  cout<<"-------------------- be string x elemtype kind "<<x->type->elemType->kind<<endl;
                  
                }else{
                  cout<<"--------------------     op x no es de tipo string o char[] "<<y->type->kind<<" anteponeindo itos"<<endl;
                  if(x->type->kind == Struct::Int){
                    code->put(ITOS);

                  }else if(x->type->kind == Struct::Float){
                    code->put(FTOS);
                  }else if(x->type->kind == Struct::Double){
                    code->put(DTOS);
                  }else if(false && x->type->kind == Struct::Class){
                    Obj * tmpO = tab->find(x->obj->name);
                    Operand * otmp0 = new Operand(tmpO);
                    Obj * fld = tab->findField("toString",tmpO->type);
                    Operand * otmp1 = new Operand(fld);
                    cout<<"op x: "<< tmpO->name <<", es un objeto de clase: "<<endl;
                    if(fld != SymbolTable::noObj){
                      
                    cout<<"op x contiene el metodo toString: adr "<<fld->adr<<endl;
                    //llamar al metodo toString de la clase
                    code->load(otmp0);
                    FunctionCall(otmp1);
                    }else{
                      
                    
                    SemErr(L"---- op x NO contiene el metodo toString.");
                    }
                    //SemErr(L"---- op x es un objeto de clase .");
                  }else{
                    
                    SemErr(L"---- op x no se puede llevar implicitamente a string.");
                  }
                }
               /*
                if(x->type->elemType->kind == Struct::Char || y->type->elemType->kind == Struct::Char){

                }else{
                  SemErr(L"------------- x o y no son string o char[]");
                }*/
                
               
                cout<<"-------------------- string x "<<x->type->kind<<endl;
                cout<<"-------------------- string y "<<y->type->kind<<endl;
               

               code->put(STRCAT);
                
              }else  if(
                (x->type == SymbolTable::floatType || x->type->kind == Struct::Float)
                ||
                (y->type == SymbolTable::floatType || y->type->kind == Struct::Float)
              ){

                  code->load(y);
                  cout<<"||||||||||||||||||||| 1 y float: "<<y->type->kind<<" val:"<<x->val<<endl;
                  if(y->type != SymbolTable::floatType && y->type->kind != Struct::Float){
                      cout<<"||||||||||||||||||||| 2 y not float, ITOF"<<y->type->kind<<endl;
                      code->put(ITOF);
                      y->type =SymbolTable::floatType;
                  }

                  code->load(x);
                  cout<<"||||||||||||||||||||| 1 x float: "<<x->type->kind<<" val:"<<x->val<<endl;
                  if(x->type != SymbolTable::floatType && x->type->kind != Struct::Float){
                      cout<<"||||||||||||||||||||| 2 x not float, ITOF"<<x->type->kind<<endl;
                      code->put(ITOF);
                      x->type =SymbolTable::floatType;
                  }

                 
                 
               
                  switch(op){
                    case ADD:{
                      code->put(FADD);
                      break;
                    }
                    case SUB:{
                      code->put(FSUB);
                      break;
                    }
                    case MUL:{
                      code->put(FMUL);
                      break;
                    }
                    case DIV:{
                      code->put(FDIV);
                      break;
                    }
                    case MOD:{
                      code->put(FMOD);
                      break;
                    }
                  }
                
              
              }else if(
                (x->type == SymbolTable::intType || x->type->kind == Struct::Int)
                ||
                (y->type == SymbolTable::intType || y->type->kind == Struct::Int)
              ){
              code->load(y);
              code->load(x);
              code->put(op);
              }
   						

   					.)

   					}.


  
  Term<AbstractOperand* &result_op>
  (. AbstractOperand *factor_op = nullptr, *next_factor_op = nullptr;
     int mul_op_kind = 0; // 3:MUL, 4:DIV, 5:MOD
     DvVmOperand *res_vm_op_term, *next_vm_op_term; // For type inspection
  .)
  = Factor<factor_op>
    (. result_op = factor_op; .)
    {Mulop<mul_op_kind> Factor<next_factor_op>
		(. if(result_op && next_factor_op) {
             res_vm_op_term = dynamic_cast<DvVmOperand*>(result_op);
             next_vm_op_term = dynamic_cast<DvVmOperand*>(next_factor_op);

             if (!res_vm_op_term || !next_vm_op_term) {
                 SemErr(L"Type information unavailable for operands in Term.");
                 // Fallback to generic operations
                 if(mul_op_kind == 3) cg->emitMultiply(result_op, next_factor_op, result_op);
                 else if(mul_op_kind == 4) cg->emitDivide(result_op, next_factor_op, result_op);
                 else if(mul_op_kind == 5) cg->emitModulo(result_op, next_factor_op, result_op);
             } else {
                 // Type handling for MUL, DIV, MOD (similar to ADD, SUB in Expr)
                 // DvVmCodeGenerator's emitMultiply etc. already handle int/double promotion.
                 // No special string operations for MUL/DIV/MOD.
                 if(mul_op_kind == 3 /*MUL*/) {
                     cg->emitMultiply(result_op, next_factor_op, result_op);
                 } else if(mul_op_kind == 4 /*DIV*/) {
                     cg->emitDivide(result_op, next_factor_op, result_op);
                 } else if(mul_op_kind == 5 /*MOD*/) {
                     cg->emitModulo(result_op, next_factor_op, result_op);
                 }
             }
           } else { SemErr(L"Invalid operands for multiplicative operation in Term."); }
		.)
	}.

  Factor<AbstractOperand* &result_op>
  // (. AbstractOperand *y_op = nullptr; Operand* x_legacy = new Operand(0); std::vector<AbstractOperand*> args_ops; .) // Old variables
  (. AbstractOperand *designator_op = nullptr;
     Obj* obj_info_from_designator = nullptr; // To get metadata from Designator
     std::vector<AbstractOperand*> args_ops;
     AbstractOperand *expr_op_for_parens = nullptr; // For ( Expr )
     AbstractOperand *expr_op_for_array_size = nullptr; // For new type[Expr]
     string literal_str_val; // For string literals
     int literal_int_val; // For number literals
     float literal_float_val; // For float literals
  .)
  = Designator<designator_op, obj_info_from_designator>
    (. result_op = designator_op; .)
    [ ActPars<args_ops>
      (.
         if (result_op && obj_info_from_designator && (obj_info_from_designator->kind == Obj::Fun || obj_info_from_designator->kind == Obj::Meth)) {
             AbstractOperand* call_target_op = nullptr;
             if (obj_info_from_designator->native) {
                 cg->emitNativeCall(obj_info_from_designator->name, obj_info_from_designator->native_id, args_ops, call_target_op);
             } else {
                 cg->emitCall(result_op, args_ops, call_target_op);
             }
             // result_op should now represent value on stack if emitCall/emitNativeCall leaves it there
         } else { SemErr(L"Not a callable function/method in Factor."); }
      .)
    ]
    (.
        if (args_ops.empty() && result_op && obj_info_from_designator &&
            !(obj_info_from_designator->kind == Obj::Fun || obj_info_from_designator->kind == Obj::Meth)) {
            cg->emitPush(result_op);
        }
    .)
  
  | ident   (.
               string ident_name = coco_string_create_char(t->val);
  			   Obj * obj = tab->find(ident_name);
               if(obj) {
                   if(obj->kind == Obj::Var) {
                       if(obj->level == 0) result_op = cg->createGlobalVariableOperand(obj->adr, obj->type);
                       else result_op = cg->createLocalVariableOperand(obj->adr, obj->type);
                       cg->emitPush(result_op);
                   } else if (obj->kind == Obj::Con) {
                       result_op = cg->createConstantIntegerOperand(obj->val);
                       cg->emitPush(result_op);
                   } else { SemErr(L"Identifier in Factor is not a variable or constant."); result_op = nullptr; }
               } else { SemErr(L"Identifier not found in Factor."); result_op = nullptr;}
			.)
  | floatLit (. literal_float_val = NUMBERS::Numbers::StringToFloat(coco_string_create_char(t->val)); // Helper might be needed
                 result_op = cg->createConstantDoubleOperand(literal_float_val); // Assuming float is stored as double
                 cg->emitPush(result_op);
  			.) 
  | number  (. literal_int_val = stoi(coco_string_create_char(t->val));
                 result_op = cg->createConstantIntegerOperand(literal_int_val);
                 cg->emitPush(result_op);
  			.) 
  | stringConst (.
                  literal_str_val = onlyContent(string(coco_string_create_char(t->val)));
                  result_op = cg->createConstantStringOperand(literal_str_val);
                  cg->emitPush(result_op);
                .)

  | "new" ident (. string class_name_str = coco_string_create_char(t->val);
					Obj* class_obj_info = tab->find(class_name_str);
					if(!class_obj_info || class_obj_info->type->kind != Struct::Class) {
                        SemErr(L"Not a class type for new: " + coco_string_to_wstring(t->val)); result_op = nullptr;
                    } else {
                        // This path is for "new ClassName" potentially followed by constructor call or array dimension.
                        // The actual NEW instruction emission depends on what follows (parens or brackets).
                        // Store class_obj_info for later use by ActPars or array dimension.
                        // result_op at this point is more of a placeholder for type, not a generated operand yet.
                        // This logic is tricky. Let's assume 'new' primarily sets up context.
                        // The actual object/array creation is in the alternatives.
                    }
  				 .)
	 ( IF(la->kind == _popen) // Matches "new ClassName (...)" - Constructor call
        ActPars<args_ops>
         (.  if(class_obj_info) {
                 cg->emitNewObject(class_obj_info->type, nullptr /* result on stack */);
                 cg->emitDuplicate();
                 Obj* constr_method_obj = tab->findField("construct", class_obj_info->type);
                 if (constr_method_obj && constr_method_obj->kind == Obj::Meth) {
                     AbstractOperand* constr_func_op = cg->createFunctionNameOperand(constr_method_obj->name);
                     cg->emitCall(constr_func_op, args_ops, nullptr);
                 } else {
                     cg->emitPop(nullptr);
                 }
                 // result_op should represent the new object on stack
             } else { SemErr(L"Class info missing for new with constructor."); }
         .)
    | IF(la->kind == _bopen) // Matches "new Type [...]" - Array creation
        "[" Expr<expr_op_for_array_size> "]"
         (.      if(class_obj_info && expr_op_for_array_size) {
                     cg->emitNewArray(class_obj_info->type /* element type */, expr_op_for_array_size /* size */, nullptr /* result on stack */);
                 } else { SemErr(L"Invalid array creation in Factor."); }
		 .)
    | // Matches "new ClassName" - Simple object creation, no explicit constructor call here
         (. if(class_obj_info) {
                cg->emitNewObject(class_obj_info->type, nullptr /* result on stack */);
            } else { SemErr(L"Class info missing for simple new."); }
         .)
	 )
     (. // result_op should represent the new object/array address on stack.
     .)
  | "(" Expr<result_op> ")" .

  Designator <AbstractOperand* &des_op, Obj* &obj_info_out>  // Output: des_op (operand), obj_info_out (symbol table entry for final ident)
  (. //AbstractOperand *current_base_op = nullptr; // Use des_op directly as current_base_op
     Obj* current_obj = nullptr;
     string ident_str;
     AbstractOperand* index_expr_op = nullptr;
     //string name_qualifier_debug; // For debug cout
  .)
   = ident (. ident_str = coco_string_create_char(t->val);
              //name_qualifier_debug = ident_str;
			  current_obj = tab->find(ident_str);
              obj_info_out = current_obj;

              if(!current_obj || current_obj == SymbolTable::noObj) {
                  SemErr(L"Identifier not found: " + coco_string_to_wstring(t->val));
                  des_op = nullptr;
		          errors->Exception(L"");
              } else {
                  //cout<<"Designator initial ident: "<<ident_str<<" obj kind: "<<current_obj->kind<<endl;
                  if(current_obj->kind == Obj::Var) {
                      if(current_obj->level == 0) des_op = cg->createGlobalVariableOperand(current_obj->adr, current_obj->type);
                      else des_op = cg->createLocalVariableOperand(current_obj->adr, current_obj->type);
                  } else if (current_obj->kind == Obj::Con) {
                      des_op = cg->createConstantIntegerOperand(current_obj->val); // TODO: Handle other const types
                  } else if (current_obj->kind == Obj::Fun || current_obj->kind == Obj::Meth) {
                      des_op = cg->createFunctionNameOperand(current_obj->name);
                  } else {
                      SemErr(L"Identifier is not a variable, constant, or function: " + coco_string_to_wstring(t->val));
                      des_op = nullptr;
                  }
              }
			 .)

    { ("." ident
        (. if(des_op && current_obj && current_obj->type->kind == Struct::Class){
			ident_str = coco_string_create_char(t->val);
			Obj * field_obj = tab->findField(ident_str, current_obj->type);
                obj_info_out = field_obj;
                if(!field_obj || field_obj == SymbolTable::noObj) {
                    SemErr(L"Field not found: '" + coco_string_to_wstring(t->val) + L"' in object '"+ coco_string_to_wstring(current_obj->name.c_str()) + L"'");
                    des_op = nullptr;
                } else {
                    des_op = cg->createFieldOperand(des_op /*base_op*/, field_obj->adr /*offset*/, field_obj->type);
                    current_obj = field_obj;
                }
		} else{ SemErr(L"Not an object for field access, or prior error in Designator base."); des_op = nullptr; }
	.)
      | ("[" Expr<index_expr_op>
          (.
             if(des_op && current_obj && current_obj->type->kind == Struct::Arr){
                // TODO: Type check index_expr_op, should be int.
                // if (index_expr_op && index_expr_op->type == SymbolTable::intType) { // Assuming SymbolTable::intType exists
                    des_op = cg->createArrayElementOperand(des_op /*array base_op*/, index_expr_op, current_obj->type->elemType);
                    // Update current_obj to reflect the element's type for further qualifications.
                    // This might involve creating a temporary Obj or finding one if elemType is named.
                    // For now, if elemType is primitive, current_obj might become less useful for further field access.
                    if (current_obj->type->elemType->kind != Struct::Int && current_obj->type->elemType->kind != Struct::Char && current_obj->type->elemType->kind != Struct::Float) {
                         current_obj = tab->find(current_obj->type->elemType->name); // This assumes elemType has a name and is in symtab
                    } else {
                         current_obj = SymbolTable::noObj; // Primitive element, no further Obj fields
                    }
                    obj_info_out = current_obj;
                // } else { SemErr(L"Array index must be an integer."); des_op = nullptr; }
             } else { SemErr(L"Not an array or invalid index expression for Designator."); des_op = nullptr; }
    	  .)
         "]"
        )
     )}.
  Addop<int & op> = "+" (. op = 1; .) | "-" (. op = 2; .).
  Mulop<int & op>  = "*"  (. op = 3; .)| "/" (. op = 4; .) | "%" (. op = 5; .).

  Mcode = "mcode"  "begin"  ASM  "end".
  ASM               = StatementSequence   .
  StatementSequence = { McodeStatement   } .
  McodeStatement  (. int addres; .) 
    = Executable | Directive<addres> .
  Executable     (. int op,addres; op=0,addres = 0; .)  
   = [ Label ] [ OneByteOp<op> (. code->put(op); .)| TwoByteOp<op> Address<addres> (. code->put(op); code->put(addres); .)  ] .
  OneByteOp<int & op>        = "ADD" (. op = ADD; .) | "PSH"|  "POP" | "CALL" (. op = CALL_S; .) | "ALEN" (. op=ALEN; .) .
  TwoByteOp<int & op>        = "LDA"(. op = ILOADL; .) | "STORE" (. op = ISTOREL; .) | "GOTO" |"ICONST" (. op = ICONST; .)   .
  Address<int & addres> 
    = Label | number (. 
                        string str_val = coco_string_create_char(t->val);
                        addres = stoi(str_val);
                  .).
  Directive<int & addres>
    =   Label "EQU" KnownAddress<addres>
          | [ Label ] ( "DC" Address<addres> | "DS" KnownAddress<addres> )
          | "ORG" KnownAddress<addres> | "BEG" .
  Label             = ident .
  KnownAddress<int & addres>      = Address<addres> .

 
  LoadExp = {Load} .
  Load = 
        ("@>"|"@include") 
        stringConst (. string i_file(coco_string_create_char(t->val)); cout<<"include: "<<i_file<<endl; 
        ((type_f) _p)(onlyContent(i_file)); .)  ";".


  LibLoad = ("@>l"|"@load_lib")   stringConst
      (.
        if(lib_info->load_any){
          SemErr(L"No se puede cargar mas de una libreria por archivo.");
        }
        string lib_path(onlyContent(coco_string_create_char(t->val)));
        lib_info->name = lib_path;
        lib_info->load_any=true;
        cout<<"lib_load: "<<lib_info->name<<endl;
      .)
       ";" .

END Program.